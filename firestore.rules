rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasCourse(courseId) {
      return signedIn()
        && exists(/databases/$(database)/documents/userEntitlements/$(request.auth.uid)/courses/$(courseId));
    }

    function profileIsAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function keepsAccountControls() {
      return request.resource.data.get('role', null) == resource.data.get('role', null)
        && request.resource.data.get('stripeCustomerId', null)
             == resource.data.get('stripeCustomerId', null);
    }

    // Admin panel login is a password session, not a Firebase Auth role.
    // Course management and assignment must work for that session.
    function assignsCoursesOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['courses']);
    }

    // Existing CMS writes remain public until the separate admin-auth migration.
    match /courses/{docId} {
      allow read, write: if true;
    }
    match /news/{docId} {
      allow read, write: if true;
    }
    match /trackRecord/{docId} {
      allow read, write: if true;
    }
    match /studentMessages/{docId} {
      allow read, write: if true;
    }
    match /onlineTests/{docId} {
      allow read, write: if true;
    }
    match /merchandise/{docId} {
      allow read, write: if true;
    }

    match /onlineVideoCourses/{courseId} {
      allow read, create, update, delete: if true;

      match /lessons/{lessonId} {
        allow read, create, update, delete: if true;
      }
    }

    match /purchases/{purchaseId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false; // Admin SDK / Cloud Functions only
    }

    match /userEntitlements/{userId} {
      allow read: if profileIsAdmin() || ownsUser(userId);
      allow write: if profileIsAdmin();

      match /courses/{courseId} {
        allow read: if profileIsAdmin() || ownsUser(userId);
        allow write: if profileIsAdmin();
      }
    }

    match /stripeWebhookEvents/{eventId} {
      allow read, write: if false; // Admin SDK / Cloud Functions only
    }

    match /admin/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if true;

      allow create: if ownsUser(userId)
        && request.resource.data.role == 'customer';

      // The admin panel is a password session, so request.auth is null there.
      // A courses-only update is how that session assigns access.
      allow update: if assignsCoursesOnly()
        || (keepsAccountControls() && (profileIsAdmin() || ownsUser(userId)));

      allow delete: if profileIsAdmin();

      match /cart/{itemId} {
        allow read, write: if ownsUser(userId);
      }
      match /orders/{orderId} {
        allow read, write: if ownsUser(userId);
      }
      match /enrollments/{courseId} {
        allow read, write: if profileIsAdmin() || ownsUser(userId);
      }
      match /wishlist/{productId} {
        allow read, write: if ownsUser(userId);
      }
      match /courseProgress/{courseId} {
        allow read, write: if ownsUser(userId);

        match /lessons/{lessonId} {
          allow read, write: if ownsUser(userId);
        }
      }

      match /studentIntake/{docId} {
        allow read: if true;
        allow create, update: if ownsUser(userId)
          && request.resource.data.completed == true
          && request.resource.data.uid == userId;
        // The admin panel is a password session, so request.auth is null there.
        allow delete: if true;
      }
    }

    // Admin Student Info lists every saved form. The admin session is not Firebase Auth.
    match /{path=**}/studentIntake/{docId} {
      allow read: if true;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if profileIsAdmin();
    }

    match /coupons/{code} {
      allow read: if signedIn();
      allow write: if profileIsAdmin();
    }

    match /onlineTestAttempts/{attemptId} {
      allow read: if signedIn()
        && resource.data.email == request.auth.token.email;

      allow create: if signedIn()
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.testId is string
        && !exists(/databases/$(database)/documents/onlineTestAttempts/$(attemptId));

      allow update: if signedIn()
        && resource.data.email == request.auth.token.email
        && request.resource.data.email == resource.data.email
        && request.resource.data.testId == resource.data.testId;

      allow delete: if false;
    }

    match /aptitudeReviews/{reviewId} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.auth.uid == reviewId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() > 0
        && request.resource.data.comment.size() <= 500
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'rating', 'comment', 'updatedAt']);
      allow delete: if signedIn() && request.auth.uid == reviewId;
    }
  }
}
