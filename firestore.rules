service cloud.firestore {
  match /databases/{database}/documents {
    // Public site content (CMS — admin panel uses client writes; tighten when admin uses Firebase Auth)
    match /courses/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /news/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /trackRecord/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /studentMessages/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /onlineTests/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Commerce catalogs (CMS client writes — tighten when admin uses Firebase Auth)
    match /merchandise/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /onlineVideoCourses/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Purchases: users read own; writes should come from payment webhook (Admin SDK).
    // Temporary: authenticated users may read own purchases only.
    match /purchases/{purchaseId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Course entitlements: users read own; only backend should write.
    match /userEntitlements/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;

      match /courses/{courseId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    match /admin/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Google sign-in user profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // One attempt per email per test
    match /onlineTestAttempts/{attemptId} {
      allow read: if request.auth != null
        && resource.data.email == request.auth.token.email;

      allow create: if request.auth != null
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.testId is string
        && !exists(/databases/$(database)/documents/onlineTestAttempts/$(attemptId));

      allow update: if request.auth != null
        && resource.data.email == request.auth.token.email;
