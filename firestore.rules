rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasCourse(courseId) {
      return signedIn()
        && exists(/databases/$(database)/documents/userEntitlements/$(request.auth.uid)/courses/$(courseId));
    }

    function profileIsAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Existing CMS writes remain public until the separate admin-auth migration.
    match /courses/{docId} {
      allow read, write: if true;
    }
    match /news/{docId} {
      allow read, write: if true;
    }
    match /trackRecord/{docId} {
      allow read, write: if true;
    }
    match /studentMessages/{docId} {
      allow read, write: if true;
    }
    match /onlineTests/{docId} {
      allow read, write: if true;
    }
    match /merchandise/{docId} {
      allow read, write: if true;
    }

    match /onlineVideoCourses/{courseId} {
      allow read, write: if true;

      match /lessons/{lessonId} {
        allow read: if hasCourse(courseId);
        // Intentional temporary exception for the legacy session-only admin UI.
        allow write: if true;
      }
    }

    match /purchases/{purchaseId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /userEntitlements/{userId} {
      allow read: if ownsUser(userId);
      allow write: if false;

      match /courses/{courseId} {
        allow read: if ownsUser(userId);
        allow write: if false;
      }
    }

    match /stripeWebhookEvents/{eventId} {
      allow read, write: if false;
    }

    match /admin/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if ownsUser(userId);
      allow create: if ownsUser(userId)
        && request.resource.data.role == 'customer';
      allow update: if ownsUser(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.stripeCustomerId == resource.data.stripeCustomerId;
      allow delete: if false;

      match /cart/{itemId} {
        allow read, write: if ownsUser(userId);
      }
      match /orders/{orderId} {
        allow read, write: if ownsUser(userId);
      }
      match /enrollments/{courseId} {
        allow read, write: if ownsUser(userId);
      }
      match /wishlist/{productId} {
        allow read, write: if ownsUser(userId);
      }
      match /courseProgress/{courseId} {
        allow read, write: if ownsUser(userId) && hasCourse(courseId);

        match /lessons/{lessonId} {
          allow read, write: if ownsUser(userId) && hasCourse(courseId);
        }
      }
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if profileIsAdmin();
    }

    match /coupons/{code} {
      allow read: if signedIn();
      allow write: if profileIsAdmin();
    }

    match /onlineTestAttempts/{attemptId} {
      allow read: if signedIn()
        && resource.data.email == request.auth.token.email;
      allow create: if signedIn()
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.testId is string
        && !exists(/databases/$(database)/documents/onlineTestAttempts/$(attemptId));
      allow update: if signedIn()
        && resource.data.email == request.auth.token.email
        && request.resource.data.email == resource.data.email
        && request.resource.data.testId == resource.data.testId;
      allow delete: if false;
    }
  }
}
