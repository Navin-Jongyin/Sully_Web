# Firebase Web App configuration
# Copy this file to .env and fill in the values from your Firebase console:
# https://console.firebase.google.com/project/_/settings/general

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Interview booking Firebase (separate project; optional — defaults to interview-booking-64178)
VITE_BOOKING_FIREBASE_API_KEY=
VITE_BOOKING_FIREBASE_AUTH_DOMAIN=
VITE_BOOKING_FIREBASE_PROJECT_ID=
VITE_BOOKING_FIREBASE_STORAGE_BUCKET=
VITE_BOOKING_FIREBASE_MESSAGING_SENDER_ID=
VITE_BOOKING_FIREBASE_APP_ID=
VITE_BOOKING_FIREBASE_MEASUREMENT_ID=

# Payments (Stripe Firebase Functions) — see docs/PAYMENTS.md
# Leave empty to derive the production Functions URL from VITE_FIREBASE_PROJECT_ID.
# Use "local" for the Firebase Functions emulator, or provide a custom Functions base URL.
VITE_PAYMENT_API_URL=
VITE_STRIPE_CATALOG_API_URL=https://stripe-server-3dqx.onrender.com

# Mux video backend — see docs/MUX.md
VITE_MUX_API_URL=
