rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isImage() {
      return request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function isCourseDownload() {
      return request.resource != null
        && request.resource.size < 50 * 1024 * 1024
        && (
          request.resource.contentType.matches('application/pdf')
          || request.resource.contentType.matches('application/zip')
          || request.resource.contentType.matches('application/x-zip-compressed')
          || request.resource.contentType.matches('application/msword')
          || request.resource.contentType.matches('application/vnd\\..*')
          || request.resource.contentType.matches('text/plain')
        );
    }

    function profileIsAdmin() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /online-course-thumbnails/{courseId}/{fileName} {
      allow read: if true;
      allow create, update, delete: if isImage();
    }

    match /online-course-files/{courseId}/{fileName} {
      allow read: if true;
      allow create, update: if isCourseDownload();
      allow delete: if true;
    }

    match /uploads/{fileName} {
      allow read: if true;
      allow create, update, delete: if isImage();
    }

    match /products/{productId}/{fileName} {
      allow read: if true;
      allow create, update: if profileIsAdmin() && isImage();
      allow delete: if profileIsAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
