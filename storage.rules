rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isImage() {
      return request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function isPdfOrImage() {
      return request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
        );
    }

    function profileIsAdmin() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /online-course-thumbnails/{courseId}/{fileName} {
      allow read: if true;
      allow create, update, delete: if isImage();
    }

    match /online-course-materials/{courseId}/{lessonId}/{fileName} {
      allow read: if true;
      allow create, update, delete: if isPdfOrImage();
    }

    match /uploads/{fileName} {
      allow read: if true;
      allow create, update, delete: if isImage();
    }

    match /products/{productId}/{fileName} {
      allow read: if true;
      allow create, update: if profileIsAdmin() && isImage();
      allow delete: if profileIsAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
